{
  "manifest_version": 3,
  "name": "Tells: spot machine-made writing",
  "short_name": "Tells",
  "version": "0.2.0",
  "description": "Underlines the phrases that make writing read AI-made as you type, with what to write instead. Runs on your device; sends nothing.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "contextMenus"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "homepage_url": "https://szoloth.com/tells"
}
